# ==========================================
# DataAgent AI — Environment Configuration
# ==========================================

# Backend Server Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Connection (Local or MongoDB Atlas cloud URL)
MONGODB_URI=mongodb://localhost:27017/dataagent_ai
MONGODB_DATABASE=dataagent_ai
STORAGE_BACKEND=mongodb
MAX_UPLOAD_SIZE_MB=25

# Google Gemini AI Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Frontend Configuration (Used when building/running frontend)
VITE_API_BASE_URL=http://localhost:8000/api

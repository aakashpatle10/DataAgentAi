# Backend Server
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Connection (Supports MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/dataagent_ai
MONGODB_DATABASE=dataagent_ai
STORAGE_BACKEND=mongodb
MAX_UPLOAD_SIZE_MB=25

# Gemini AI Provider
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
